{
  "atomCode": "fast_git_clone",
  "execution": {
    "language": "java",
    "minimumVersion": "1.8",
    "target": "$bk_java_path -Dfile.encoding=UTF-8 -jar fast_git_clone.jar",
    "packagePath": "fast_git_clone.jar",
    "demands": [],
    "post": {
      "postEntryParam": "True",
      "postCondition": "always()"
    }
  },
  "input": {
    "repositoryType": {
      "label": "代码库来源",
      "default": "URL",
      "desc": "选择蓝盾代码库时自动使用代码库绑定的授权信息；自定义 URL 时使用下方用户名和 Token",
      "type": "enum-input",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false,
      "list": [
        {
          "label": "按蓝盾代码库选择",
          "value": "ID"
        },
        {
          "label": "按蓝盾代码库别名输入",
          "value": "NAME"
        },
        {
          "label": "按自定义仓库 URL 输入",
          "value": "URL"
        }
      ]
    },
    "repositoryHashId": {
      "label": "蓝盾代码库",
      "default": "",
      "placeholder": "请选择代码库名称",
      "type": "selector",
      "desc": "仅展示当前用户有 USE 权限的蓝盾代码库",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false,
      "optionsConf": {
        "searchable": true,
        "multiple": false,
        "url": "/repository/api/user/repositories/{projectId}/hasPermissionList?permission=USE&page=1&pageSize=5000",
        "paramId": "repositoryHashId",
        "paramName": "aliasName",
        "itemTargetUrl": "/codelib/{projectId}/",
        "itemText": "关联代码库",
        "hasAddItem": true
      },
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "repositoryType",
            "value": "ID"
          }
        ]
      }
    },
    "repositoryName": {
      "label": "蓝盾代码库别名",
      "default": "",
      "placeholder": "请输入代码库别名",
      "type": "vuex-input",
      "desc": "按蓝盾代码库别名查询代码库详情，并自动使用其绑定授权",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false,
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "repositoryType",
            "value": "NAME"
          }
        ]
      }
    },
    "GIT_USERNAME": {
      "label": "Git 用户名",
      "default": "",
      "placeholder": "请输入 Git 用户名",
      "type": "vuex-input",
      "desc": "用于 Git credential helper 动态提供认证的用户名",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false,
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "repositoryType",
            "value": "URL"
          }
        ]
      }
    },
    "GIT_TOKEN": {
      "label": "Git Token",
      "default": "",
      "placeholder": "请输入 Git Token 或密码",
      "type": "vuex-input",
      "desc": "用于 Git credential helper 动态提供认证的访问凭证，不会写入 ~/.git-credentials；同一 Job 后续步骤可复用，构建结束清理",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": true,
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "repositoryType",
            "value": "URL"
          }
        ]
      }
    },
    "GIT_HOST": {
      "label": "Git 域名",
      "default": "code.cwoa.net",
      "placeholder": "code.cwoa.net",
      "type": "vuex-input",
      "desc": "自定义仓库 URL 模式下用于解析认证域名，凭证通过 Git credential helper 提供",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false,
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "repositoryType",
            "value": "URL"
          }
        ]
      }
    },
    "KINGEYE_GIT_REPO": {
      "label": "Git 仓库地址",
      "default": "",
      "placeholder": "https://code.cwoa.net/group/repo.git",
      "type": "vuex-input",
      "desc": "需要拉取的 Git 仓库 HTTPS 地址",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false,
      "rely": {
        "operation": "AND",
        "expression": [
          {
            "key": "repositoryType",
            "value": "URL"
          }
        ]
      }
    },
    "BRANCH": {
      "label": "仓库分支",
      "default": "",
      "placeholder": "main 或 {\"repositoryHashId\":\"xxx\",\"branchName\":\"main\"}",
      "type": "vuex-input",
      "desc": "支持直接填写分支名，也支持包含 branchName 字段的 JSON",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "CACHE_DIR": {
      "label": "Git 缓存目录",
      "default": "${{ci.workspace}}/git-cache/kingeye",
      "placeholder": "${{ci.workspace}}/git-cache/kingeye",
      "type": "vuex-input",
      "desc": "常驻 Git 缓存目录，目录下会保留 .git",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "TARGET_DIR": {
      "label": "目标代码目录",
      "default": "${{ci.workspace}}/${{ci.build_num}}/kingeye_source",
      "placeholder": "${{ci.workspace}}/${{ci.build_num}}/kingeye_source",
      "type": "vuex-input",
      "desc": "插件最终复制代码的位置，不允许与默认工作目录相同",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "EXCLUDE_GIT_DIR": {
      "label": "排除 .git 目录",
      "default": "true",
      "placeholder": "true、false 或 !${{variables.BUILD_REPORT}}",
      "type": "vuex-input",
      "desc": "控制 rsync 是否添加 --exclude=.git；支持 true/false、1/0、yes/no、on/off，可填写流水线变量，也可在前面加 ! 取反",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "DEFAULT_WORK_DIR": {
      "label": "默认工作目录",
      "default": "${{ci.workspace}}",
      "placeholder": "${{ci.workspace}}",
      "type": "vuex-input",
      "desc": "用于目标目录安全校验，可按流水线实际工作目录调整",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    }
  },
  "output": {
    "targetBranch": {
      "description": "实际同步的分支",
      "type": "string",
      "isSensitive": false
    },
    "commitId": {
      "description": "同步后的 Commit ID",
      "type": "string",
      "isSensitive": false
    },
    "targetDir": {
      "description": "目标代码目录",
      "type": "string",
      "isSensitive": false
    },
    "cacheDir": {
      "description": "Git 缓存目录",
      "type": "string",
      "isSensitive": false
    }
  }
}