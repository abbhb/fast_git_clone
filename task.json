{
  "atomCode": "fast_git_clone",
  "execution": {
    "language": "java",
    "minimumVersion": "1.8",
    "target": "$bk_java_path -jar fast_git_clone.jar -Dfile.encoding=utf8",
    "packagePath": "fast_git_clone.jar",
    "demands": []
  },
  "input": {
    "GIT_USERNAME": {
      "label": "Git 用户名",
      "default": "",
      "placeholder": "请输入 Git 用户名",
      "type": "vuex-input",
      "desc": "用于写入 Git credential store 的用户名",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "GIT_TOKEN": {
      "label": "Git Token",
      "default": "",
      "placeholder": "请输入 Git Token 或密码",
      "type": "vuex-input",
      "desc": "用于写入 Git credential store 的访问凭证",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": true
    },
    "GIT_HOST": {
      "label": "Git 域名",
      "default": "code.cwoa.net",
      "placeholder": "code.cwoa.net",
      "type": "vuex-input",
      "desc": "写入 ~/.git-credentials 的 Git 域名",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "KINGEYE_GIT_REPO": {
      "label": "Git 仓库地址",
      "default": "",
      "placeholder": "https://code.cwoa.net/group/repo.git",
      "type": "vuex-input",
      "desc": "需要拉取的 Git 仓库 HTTPS 地址",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "BRANCH": {
      "label": "仓库分支",
      "default": "",
      "placeholder": "main 或 {\"repositoryHashId\":\"xxx\",\"branchName\":\"main\"}",
      "type": "vuex-input",
      "desc": "支持直接填写分支名，也支持包含 branchName 字段的 JSON",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "CACHE_DIR": {
      "label": "Git 缓存目录",
      "default": "${{ci.workspace}}/git-cache/kingeye",
      "placeholder": "${{ci.workspace}}/git-cache/kingeye",
      "type": "vuex-input",
      "desc": "常驻 Git 缓存目录，目录下会保留 .git",
      "required": false,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "TARGET_DIR": {
      "label": "目标代码目录",
      "default": "${{ci.workspace}}/${{ci.build_num}}/kingeye_source",
      "placeholder": "${{ci.workspace}}/${{ci.build_num}}/kingeye_source",
      "type": "vuex-input",
      "desc": "插件最终复制代码的位置，不允许与默认工作目录相同",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    },
    "DEFAULT_WORK_DIR": {
      "label": "默认工作目录",
      "default": "${{ci.workspace}}",
      "placeholder": "${{ci.workspace}}",
      "type": "vuex-input",
      "desc": "用于目标目录安全校验，可按流水线实际工作目录调整",
      "required": true,
      "disabled": false,
      "hidden": false,
      "isSensitive": false
    }
  },
  "output": {
    "targetBranch": {
      "description": "实际同步的分支",
      "type": "string",
      "isSensitive": false
    },
    "commitId": {
      "description": "同步后的 Commit ID",
      "type": "string",
      "isSensitive": false
    },
    "targetDir": {
      "description": "目标代码目录",
      "type": "string",
      "isSensitive": false
    },
    "cacheDir": {
      "description": "Git 缓存目录",
      "type": "string",
      "isSensitive": false
    }
  }
}